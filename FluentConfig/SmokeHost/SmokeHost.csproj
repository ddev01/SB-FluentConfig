<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FluentConfig.SmokeHost</RootNamespace>
    <AssemblyName>FluentConfig.SmokeHost</AssemblyName>
    <StreamerBotPath Condition="'$(StreamerBotPath)' == '' and '$(STREAMER_BOT_PATH)' != ''">$(STREAMER_BOT_PATH)</StreamerBotPath>
    <StreamerBotPath Condition="'$(StreamerBotPath)' == '' and Exists('$(USERPROFILE)\Desktop\Streamer.bot-x64-1.0.4\Microsoft.Web.WebView2.Wpf.dll')">$(USERPROFILE)\Desktop\Streamer.bot-x64-1.0.4</StreamerBotPath>
    <StreamerBotPath Condition="'$(StreamerBotPath)' == '' and Exists('$(LOCALAPPDATA)\Microsoft\WinGet\Packages\streamerbot.streamerbot_Microsoft.Winget.Source_8wekyb3d8bbwe\Microsoft.Web.WebView2.Wpf.dll')">$(LOCALAPPDATA)\Microsoft\WinGet\Packages\streamerbot.streamerbot_Microsoft.Winget.Source_8wekyb3d8bbwe</StreamerBotPath>
    <StreamerBotPath Condition="'$(StreamerBotPath)' == ''">$(USERPROFILE)\Desktop\Streamer.bot-x64-1.0.4</StreamerBotPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Host\Host.csproj" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="Streamer.bot.Plugin.Interface">
      <HintPath>$(StreamerBotPath)\Streamer.bot.Plugin.Interface.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(StreamerBotPath)\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>$(StreamerBotPath)\Microsoft.Web.WebView2.Wpf.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
